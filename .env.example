# 本机数据库和应用变量已使用；AI/通道适配已实现，但真实服务配置和联调仍待完成。
# 使用 python scripts/local_db.py init-env 生成本机随机数据库密码；不覆盖已有 .env。
# 本文件不得放入真实凭证、服务器公网地址或客户资料。
COOLDATASIM_DB_PORT=5433
COOLDATASIM_DB_ADMIN_PASSWORD=
COOLDATASIM_DB_APP_PASSWORD=
COOLDATASIM_ENV=development
COOLDATASIM_APP_PORT=8787
COOLDATASIM_ADMIN_USERNAME=admin
COOLDATASIM_ADMIN_PASSWORD=
COOLDATASIM_DATABASE_URL=
COOLDATASIM_REDIS_URL=
COOLDATASIM_QWEN_BASE_URL=
COOLDATASIM_QWEN_MODEL=qwen3.8-27b
COOLDATASIM_QWEN_API_KEY=
# CHAT_* 整組設定會優先於 QWEN_*；不同供應者的憑證不會混用。
COOLDATASIM_CHAT_PROVIDER=
COOLDATASIM_CHAT_BASE_URL=
COOLDATASIM_CHAT_MODEL=
COOLDATASIM_CHAT_API_KEY=
COOLDATASIM_CHAT_REASONING_EFFORT=
COOLDATASIM_CHAT_SESSION_NAMESPACE=
# 獨立CPU向量服務透過本機私有轉發連接；實際URL/憑證由部署工具寫入本機.env。
# Embedding與Reranker使用本專案模型憑證，不使用CHAT_*或員工知識庫憑證。
COOLDATASIM_EMBEDDING_BASE_URL=
COOLDATASIM_EMBEDDING_API_KEY=
COOLDATASIM_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
COOLDATASIM_EMBEDDING_DIMENSIONS=1024
COOLDATASIM_RERANKER_BASE_URL=
COOLDATASIM_RERANKER_API_KEY=
COOLDATASIM_RERANKER_MODEL=Qwen3-Reranker-0.6B
COOLDATASIM_EVOLUTION_BASE_URL=
COOLDATASIM_EVOLUTION_API_KEY=
COOLDATASIM_EVOLUTION_INSTANCE=
COOLDATASIM_WEBHOOK_SECRET=
COOLDATASIM_KNOWLEDGE_ROOT_URL=https://www.cooldatasim.com/
